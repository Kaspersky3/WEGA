APP_NAME=WEGA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-domaine.sevalla.com

LOG_CHANNEL=stack
LOG_LEVEL=error

# Base de données
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wega
DB_USERNAME=root
DB_PASSWORD=

# Cache et Sessions
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ⚠️ SÉCURITÉ CRITIQUE - Cookies HTTPS
# En production, DOIT être true pour sécuriser les cookies
# Sinon le navigateur bloquera les cookies et les formulaires ne fonctionneront pas
SESSION_SECURE_COOKIE=true

# Redis (optionnel - décommentez si Redis est installé)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum (si utilisé pour API)
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,::1,votre-domaine.sevalla.com

# Trusted Proxies (pour Sevalla et autres hébergeurs cloud)
# Laisser vide - Le middleware TrustProxies est configuré pour accepter tous les proxies (*)


